-- RECIPE SHARING & AI INGREDIENT DETECTION PLATFORM
-- Thiet ke CSDL - PHIEN BAN TOI UU (PostgreSQL)
-- Thay doi so voi ban truoc:
--   - Bo module Report (khong con bang reports)
--   - notifications: bo cot actor_id (chi con user_id nguoi nhan)
-- Nguyen tac: KHONG thay doi cau truc 3 bang goc (users, recipes,
-- recipe_stats) -- chi bo sung them cot (ALTER TABLE ... ADD COLUMN).
-- =====================================================================

-- ---------------------------------------------------------------------
-- PHAN 1: BO SUNG THUOC TINH CHO 3 BANG HIEN CO
-- ---------------------------------------------------------------------

-- 1.1 users -------------------------------------------------------------
ALTER TABLE public.users
    ADD COLUMN email        character varying,
    ADD COLUMN bio          text,
    ADD COLUMN is_private   boolean NOT NULL DEFAULT false,
    ADD COLUMN role         character varying NOT NULL DEFAULT 'USER',
    ADD COLUMN status       character varying NOT NULL DEFAULT 'ACTIVE',
    ADD COLUMN updated_at   timestamp with time zone NOT NULL DEFAULT now();

ALTER TABLE public.users
    ADD CONSTRAINT users_email_key UNIQUE (email);

ALTER TABLE public.users
    ADD CONSTRAINT users_role_check CHECK (role IN ('USER','ADMIN')),
    ADD CONSTRAINT users_status_check CHECK (status IN ('ACTIVE','LOCKED'));

-- 1.2 recipes -------------------------------------------------------------
ALTER TABLE public.recipes
    ADD COLUMN description        text,
    ADD COLUMN cook_time_minutes  integer,
    ADD COLUMN servings           integer,
    ADD COLUMN difficulty         character varying,
    ADD COLUMN updated_at         timestamp with time zone NOT NULL DEFAULT now();

ALTER TABLE public.recipes
    ADD CONSTRAINT recipes_difficulty_check
        CHECK (difficulty IS NULL OR difficulty IN ('EASY','MEDIUM','HARD'));

-- 1.3 recipe_stats ---------------------------------------------------------
-- recipe_stats la danh muc cong thuc "chuan" dung cho tinh nang goi y AI
-- (scan_count/save_count thong ke rieng, doc lap voi bang recipes cua user).
-- Bo sung lien ket MEM DEO (nullable) toi recipes khi mot cong thuc do
-- user dang co trung voi cong thuc trong danh muc nay.
ALTER TABLE public.recipe_stats
    ADD COLUMN recipe_id integer;

ALTER TABLE public.recipe_stats
    ADD CONSTRAINT recipe_stats_recipe_id_fkey
        FOREIGN KEY (recipe_id) REFERENCES public.recipes(id) ON DELETE SET NULL;

CREATE INDEX ix_recipe_stats_recipe_id ON public.recipe_stats USING btree (recipe_id);


-- ---------------------------------------------------------------------
-- PHAN 2: CAC BANG MOI
-- ---------------------------------------------------------------------

-- 2.1 MODULE: Recipe Management (danh muc / tag) ---------------------------
CREATE TABLE public.categories (
    id          serial PRIMARY KEY,
name        character varying(100) NOT NULL,
    slug        character varying(120) NOT NULL,
    created_at  timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT categories_name_key UNIQUE (name),
    CONSTRAINT categories_slug_key UNIQUE (slug)
);

CREATE TABLE public.recipe_categories (
    id           serial PRIMARY KEY,
    recipe_id    integer NOT NULL REFERENCES public.recipes(id) ON DELETE CASCADE,
    category_id  integer NOT NULL REFERENCES public.categories(id) ON DELETE CASCADE,
    created_at   timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT recipe_categories_unique UNIQUE (recipe_id, category_id)
);
CREATE INDEX ix_recipe_categories_recipe_id ON public.recipe_categories (recipe_id);
CREATE INDEX ix_recipe_categories_category_id ON public.recipe_categories (category_id);

-- 2.2 MODULE: Search / AI Detection ho tro tra cuu nguyen lieu -------------
-- Bang phu, tach tu JSON `recipes.ingredients` de tim kiem / doi chieu
-- nguyen lieu nhanh hon (khong bat buoc, nhung khuyen nghi cho module
-- Search va goi y mon an theo nguyen lieu).
CREATE TABLE public.recipe_ingredient_index (
    id               serial PRIMARY KEY,
    recipe_id        integer NOT NULL REFERENCES public.recipes(id) ON DELETE CASCADE,
    ingredient_name  character varying(150) NOT NULL,
    CONSTRAINT recipe_ingredient_index_unique UNIQUE (recipe_id, ingredient_name)
);
CREATE INDEX ix_recipe_ingredient_index_name ON public.recipe_ingredient_index (ingredient_name);
CREATE INDEX ix_recipe_ingredient_index_recipe_id ON public.recipe_ingredient_index (recipe_id);

-- 2.3 MODULE: AI Ingredient Detection ---------------------------------------
CREATE TABLE public.ai_detection_histories (
    id                     serial PRIMARY KEY,
    user_id                integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    image_url              character varying NOT NULL,
    detected_ingredients   jsonb NOT NULL,
    created_at             timestamp with time zone NOT NULL DEFAULT now()
);
CREATE INDEX ix_ai_detection_histories_user_id ON public.ai_detection_histories (user_id);

-- 2.4 MODULE: Community Interaction -----------------------------------------
CREATE TABLE public.comments (
    id                  serial PRIMARY KEY,
    recipe_id           integer NOT NULL REFERENCES public.recipes(id) ON DELETE CASCADE,
    user_id             integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    parent_comment_id   integer REFERENCES public.comments(id) ON DELETE CASCADE,
    content             text NOT NULL,
    created_at          timestamp with time zone NOT NULL DEFAULT now(),
    updated_at          timestamp with time zone NOT NULL DEFAULT now()
);
CREATE INDEX ix_comments_recipe_id ON public.comments (recipe_id);
CREATE INDEX ix_comments_user_id ON public.comments (user_id);
CREATE INDEX ix_comments_parent_comment_id ON public.comments (parent_comment_id);

CREATE TABLE public.comment_likes (
id           serial PRIMARY KEY,
    comment_id   integer NOT NULL REFERENCES public.comments(id) ON DELETE CASCADE,
    user_id      integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    created_at   timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT comment_likes_unique UNIQUE (comment_id, user_id)
);
CREATE INDEX ix_comment_likes_comment_id ON public.comment_likes (comment_id);

CREATE TABLE public.ratings (
    id           serial PRIMARY KEY,
    recipe_id    integer NOT NULL REFERENCES public.recipes(id) ON DELETE CASCADE,
    user_id      integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    score        smallint NOT NULL,
    created_at   timestamp with time zone NOT NULL DEFAULT now(),
    updated_at   timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT ratings_unique UNIQUE (recipe_id, user_id),
    CONSTRAINT ratings_score_check CHECK (score BETWEEN 1 AND 5)
);
CREATE INDEX ix_ratings_recipe_id ON public.ratings (recipe_id);

CREATE TABLE public.favorites (
    id           serial PRIMARY KEY,
    recipe_id    integer NOT NULL REFERENCES public.recipes(id) ON DELETE CASCADE,
    user_id      integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    created_at   timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT favorites_unique UNIQUE (recipe_id, user_id)
);
CREATE INDEX ix_favorites_user_id ON public.favorites (user_id);
CREATE INDEX ix_favorites_recipe_id ON public.favorites (recipe_id);

CREATE TABLE public.follows (
    id            serial PRIMARY KEY,
    follower_id   integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    following_id  integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    created_at    timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT follows_unique UNIQUE (follower_id, following_id),
    CONSTRAINT follows_no_self_follow CHECK (follower_id <> following_id)
);
CREATE INDEX ix_follows_follower_id ON public.follows (follower_id);
CREATE INDEX ix_follows_following_id ON public.follows (following_id);

-- 2.5 MODULE: Notifications ---------------------------------------------------
-- (Da bo cot actor_id theo thiet ke toi uu - chi con nguoi nhan)
CREATE TABLE public.notifications (
    id               serial PRIMARY KEY,
    user_id          integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    type             character varying(30) NOT NULL,
    reference_type   character varying(30),
    reference_id     integer,
    is_read          boolean NOT NULL DEFAULT false,
    created_at       timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT notifications_type_check CHECK (
        type IN ('FOLLOW','LIKE','COMMENT','RATING','NEW_RECIPE')
    )
);
CREATE INDEX ix_notifications_user_id ON public.notifications (user_id);
CREATE INDEX ix_notifications_user_unread ON public.notifications (user_id, is_read);

CREATE TABLE public.notification_settings (
id                    serial PRIMARY KEY,
    user_id               integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    follow_enabled        boolean NOT NULL DEFAULT true,
    like_enabled          boolean NOT NULL DEFAULT true,
    comment_enabled       boolean NOT NULL DEFAULT true,
    rating_enabled        boolean NOT NULL DEFAULT true,
    new_recipe_enabled    boolean NOT NULL DEFAULT true,
    updated_at            timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT notification_settings_user_unique UNIQUE (user_id)
);

-- 2.6 MODULE: Collections -----------------------------------------------------
CREATE TABLE public.collections (
    id           serial PRIMARY KEY,
    user_id      integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    name         character varying(150) NOT NULL,
    is_public    boolean NOT NULL DEFAULT true,
    created_at   timestamp with time zone NOT NULL DEFAULT now(),
    updated_at   timestamp with time zone NOT NULL DEFAULT now()
);
CREATE INDEX ix_collections_user_id ON public.collections (user_id);

CREATE TABLE public.collection_recipes (
    id             serial PRIMARY KEY,
    collection_id  integer NOT NULL REFERENCES public.collections(id) ON DELETE CASCADE,
    recipe_id      integer NOT NULL REFERENCES public.recipes(id) ON DELETE CASCADE,
    created_at     timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT collection_recipes_unique UNIQUE (collection_id, recipe_id)
);
CREATE INDEX ix_collection_recipes_collection_id ON public.collection_recipes (collection_id);

-- 2.7 MODULE: Authentication (reset password / refresh token) ------------------
CREATE TABLE public.user_tokens (
    id           serial PRIMARY KEY,
    user_id      integer NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    token        character varying(255) NOT NULL,
    type         character varying(20) NOT NULL,
    expires_at   timestamp with time zone NOT NULL,
    created_at   timestamp with time zone NOT NULL DEFAULT now(),
    CONSTRAINT user_tokens_token_key UNIQUE (token),
    CONSTRAINT user_tokens_type_check CHECK (type IN ('RESET_PASSWORD','REFRESH'))
);
CREATE INDEX ix_user_tokens_user_id ON public.user_tokens (user_id);

