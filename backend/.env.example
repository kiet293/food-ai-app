APP_ENV=development
DATABASE_URL=postgresql://food_app:123456@localhost:5432/food_app_db
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:8081

# Run Flyway before API startup. Local development only:
AUTO_CREATE_SCHEMA=false
# Prefer the separate scheduler process: python -m app.workers
RUN_SCHEDULER=false
TRENDING_INTERVAL_SECONDS=3600
# Feed reads do not call Pexels unless explicitly enabled for development.
SYNC_PEXELS_ON_READ=false

# Empty uses app/modules/ai/models/egg_tomato_beff.pt
YOLO_MODEL_PATH=
GEMINI_API_KEY=
PEXELS_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
